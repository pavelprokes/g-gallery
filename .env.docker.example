# Local development against the Docker stack (compose.yaml).
#
#   cp .env.docker.example .env && pnpm db:up && pnpm db:migrate
#
# Every value here points at a container — no cloud account is needed. The
# production counterparts live in .env.example / docs/SETUP.md.

# --- Database -> postgres container ----------------------------------------
# Host port 5433 (5432 is commonly taken by another local Postgres).
# No pooler locally, so DATABASE_URL and DIRECT_URL are the same connection.
DATABASE_URL="postgres://g_gallery:g_gallery@localhost:5433/g_gallery"
DIRECT_URL="postgres://g_gallery:g_gallery@localhost:5433/g_gallery"

# --- Auth (better-auth) ----------------------------------------------------
# Dev-only value; production uses `openssl rand -base64 32`.
BETTER_AUTH_SECRET="local-development-secret-not-for-production"
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth still needs real credentials — add http://localhost:3000 as an
# authorized origin in the Google Cloud console (docs/SETUP.md §5).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS="prokespavel09@gmail.com"

# --- Object storage -> minio container (stands in for Cloudflare R2) -------
# MinIO speaks S3 SigV4 and path-style addressing, so presigning is identical.
R2_ACCOUNT_ID="local"
R2_ACCESS_KEY_ID="gallerydev"
R2_SECRET_ACCESS_KEY="gallerydev"
R2_BUCKET="g-gallery"
R2_ENDPOINT="http://localhost:9000"
# R2 only accepts "auto"; MinIO signs against a real region name.
S3_REGION="us-east-1"

# --- Image delivery -> imgproxy container ----------------------------------
NEXT_PUBLIC_IMAGE_TRANSFORM="imgproxy"
NEXT_PUBLIC_PHOTOS_BASE_URL="http://localhost:8080"
# Raw objects — the photographer's videos (docs/VIDEO.md). imgproxy above cannot
# stream an MP4, so locally they come straight from MinIO. Unset in production,
# where the image host is the bucket's own custom domain.
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:9000/g-gallery"

# --- Cron ------------------------------------------------------------------
CRON_SECRET="local-cron-secret"

# --- Mail -> mailpit container (stands in for AWS SES in prod), inbox :8025 -
SMTP_URL="smtp://localhost:1025"
NOTIFY_EMAIL_TO="prokespavel09@gmail.com"

# --- Notifications ---------------------------------------------------------
# Web Push (npx web-push generate-vapid-keys). Unset = push silently disabled.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:prokespavel09@gmail.com"
# Mail: RESEND_API_KEY wins; SMTP_URL is the local Mailpit fallback (prod uses
# AWS SES over SMTP — docs/SETUP.md §8).
MAIL_FROM="g-gallery <onboarding@resend.dev>"

# --- ZIP download (Cloudflare Worker, docs/SETUP.md §11) --------------------
# Unset = the download buttons return 503 rather than doing nothing silently.
ZIP_WORKER_URL="http://localhost:8787"
# Must match the worker secret of the same name (wrangler secret put).
ZIP_SIGNING_SECRET="local-zip-signing-secret"

# Lets the admin re-display a share/event link after creation (src/lib/token-cipher.ts).
# Optional — without it links still work, they just cannot be shown a second time.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Optional. Shown on the dead-link pages as "napiš mi" so someone whose link
# does not work has a way to reach you. Unset: the line is omitted.
NEXT_PUBLIC_CONTACT_EMAIL=

# MCP endpoint for Claude without OAuth (docs/MCP.md §Development token):
# at least 32 characters, acts as MCP_DEV_EMAIL (must be an admin). Ignored on
# a Vercel production deployment.
MCP_DEV_TOKEN=
MCP_DEV_EMAIL=

# Origins an MCP client other than Claude may register to return to
# (docs/MCP.md §Other clients), comma-separated — e.g. Paperclip on the NAS.
# Unset: client registration is off.
MCP_OAUTH_REDIRECT_ORIGINS=
