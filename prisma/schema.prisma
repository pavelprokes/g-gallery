generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Shared Supabase project (the wedding site's booking/orders data lives in
  // `public`) — g-gallery gets its own schema so migrations, RLS, and the
  // Prisma client never touch anything outside it.
  schemas  = ["g_gallery"]
}

// ---------------------------------------------------------------------------
// better-auth core models (admin plugin fields included) — keep in sync with
// `npx @better-auth/cli generate` output when upgrading better-auth.
// ---------------------------------------------------------------------------

model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  role           String?
  banned         Boolean?  @default(false)
  banReason      String?
  banExpires     DateTime?
  feedLastReadAt DateTime?
  /// Start of the last digest window actually emailed. Vercel documents cron
  /// delivery as best effort — a run can be delivered twice — and the digest is
  /// the one job where that would be visible to the recipient.
  digestSentFor  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  galleries         Gallery[]
  pushSubscriptions PushSubscription[]

  @@map("user")
  @@schema("g_gallery")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
  @@schema("g_gallery")
}

model Account {
  id                    String    @id
  // OIDC issuer of the identity, e.g. "https://accounts.google.com". Required
  // since better-auth 1.7 — accounts are keyed by (issuer, accountId), not by
  // providerId, so the same subject from two providers can't collide.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
  @@schema("g_gallery")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("g_gallery")
}

// ---------------------------------------------------------------------------
// Domain: galleries & photos
// ---------------------------------------------------------------------------

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  @@schema("g_gallery")
}

enum PhotoStatus {
  PENDING // presigned URL issued, upload not confirmed
  CONFIRMED // ETag checked in — visible in the gallery
  FAILED
  @@schema("g_gallery")
}

enum StorageTier {
  STANDARD
  INFREQUENT_ACCESS
  @@schema("g_gallery")
}

/// Background "download all" ZIP build (docs/TODO.md §7) — NONE until the
/// first build kicks off; any photo add/delete after READY drops it back to
/// PENDING rather than serving a stale archive.
enum ZipStatus {
  NONE
  PENDING
  BUILDING
  READY
  FAILED
  @@schema("g_gallery")
}

model Gallery {
  id                String        @id @default(cuid())
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  eventDate         DateTime?
  status            GalleryStatus @default(DRAFT)
  coverPhotoId      String?
  /// R2 key prefix: "galleries/<128-bit-random>" — unguessable, rotated on expiry
  storagePrefix     String        @unique
  publishedAt       DateTime?
  archivedAt        DateTime?
  /// Set when the gallery is moved to trash from the admin UI; null means it is live
  trashedAt         DateTime?
  /// Deadline for permanent deletion (trashedAt + 30 days) — the purge cron deletes past this
  purgeAt           DateTime?
  /// Throttle for instant owner push notifications (≥30 min between pushes)
  lastInstantPushAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// docs/TODO.md §7 — pre-built "download all" archive, built in the background
  /// on Cloudflare's free tier (R2 multipart + Queues), never on Vercel.
  zipStatus        ZipStatus @default(NONE)
  /// R2 object key once READY — a direct link, no Worker involved at download time
  zipObjectKey     String?
  zipSizeBytes     Int?
  zipBuiltAt       DateTime?
  /// R2 multipart upload id while BUILDING — needed to list/finalize/abort it
  zipUploadId      String?
  /// Part count the finalize step waits for via R2 listParts — set at kickoff,
  /// since it's computed from the entry list, not discovered afterwards
  zipPartsExpected Int?

  photos     Photo[]
  shareLinks ShareLink[]
  viewers    Viewer[]
  sessions   ViewSession[]
  events     ActivityEvent[]

  @@index([ownerId, status])
  @@index([zipStatus])
  @@schema("g_gallery")
}

model Photo {
  id          String      @id @default(cuid())
  galleryId   String
  gallery     Gallery     @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  /// Full R2 object key ("<storagePrefix>/<random-uuid>.jpg")
  objectKey   String      @unique
  /// Original filename, used for ZIP entries and downloads
  fileName    String
  mimeType    String      @default("image/jpeg")
  sizeBytes   Int?
  /// CRC32 (hex) computed in the browser at upload — feeds the streaming ZIP writer
  crc32       String?
  etag        String?
  width       Int?
  height      Int?
  /// Average colour as "#rrggbb", computed in the browser at upload. Fills the
  /// tile before any bytes arrive; 7 bytes per photo rather than the ~400 a
  /// base64 blur placeholder would add to every page render.
  placeholder String?
  status      PhotoStatus @default(PENDING)
  storageTier StorageTier @default(STANDARD)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  favorites Favorite[]
  reactions Reaction[]
  events    ActivityEvent[]

  @@index([galleryId, status])
  @@schema("g_gallery")
}

model ShareLink {
  id                   String    @id @default(cuid())
  galleryId            String
  gallery              Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  /// SHA-256 of the 128-bit share token — the raw token is never stored
  tokenHash            String    @unique
  label                String?
  /// scrypt hash "salt:key"; null = no password
  passwordHash         String?
  expiresAt            DateTime?
  revokedAt            DateTime?
  allowDownload        Boolean   @default(true)
  allowReactions       Boolean   @default(true)
  /// Consecutive wrong-password unlock attempts; resets to 0 on success (anti-brute-force)
  failedUnlockAttempts Int       @default(0)
  /// Set once failedUnlockAttempts hits the threshold; unlock is refused (no scrypt call) until this passes
  unlockLockedUntil    DateTime?
  /// Readable URL hint frozen at creation from title+eventDate (docs/TODO.md §6) —
  /// cosmetic only, never resolves anything; tokenHash is still the sole authority.
  /// Null on links created before this existed — `/g/{token}` alone still works.
  slug                 String?
  createdAt            DateTime  @default(now())

  viewers Viewer[]

  @@index([galleryId])
  @@schema("g_gallery")
}

// ---------------------------------------------------------------------------
// Activity & notifications (see docs/PLAN.md §8)
// GDPR: no IPs stored; viewer identity is a first-party anonKey; everything
// cascades away with the gallery; anonKey lifetime ≤ 13 months (cleanup job).
// ---------------------------------------------------------------------------

enum ActivityType {
  GALLERY_VIEW
  PHOTO_VIEW
  REACTION
  FAVORITE
  DOWNLOAD
  VISITOR_IDENTIFIED
  @@schema("g_gallery")
}

model Viewer {
  id          String     @id @default(cuid())
  galleryId   String
  gallery     Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  /// First-party localStorage UUID (crypto.randomUUID()) — the only viewer identifier
  anonKey     String
  /// Voluntarily entered via the "Kdo se dívá?" prompt — the Google Photos "join" moment
  displayName String?
  optedOut    Boolean    @default(false)
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  sessions  ViewSession[]
  favorites Favorite[]
  reactions Reaction[]
  events    ActivityEvent[]

  @@unique([galleryId, anonKey])
  @@schema("g_gallery")
}

model ViewSession {
  id             String   @id @default(cuid())
  viewerId       String
  viewer         Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  galleryId      String
  gallery        Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([galleryId, startedAt])
  @@schema("g_gallery")
}

model Favorite {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([photoId, viewerId])
  @@schema("g_gallery")
}

/// Fixed set — an open emoji field would be a free-text channel from anonymous
/// viewers into the owner's admin, and every value is a UI variant to design.
enum ReactionKind {
  LOVE
  WOW
  LAUGH
  SAD
  CLAP
  @@schema("g_gallery")
}

model Reaction {
  id        String       @id @default(cuid())
  photoId   String
  photo     Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Viewer       @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  /// One reaction per viewer per photo: picking another kind replaces it,
  /// which keeps the per-photo tally a count of people, not of clicks.
  @@unique([photoId, viewerId])
  @@index([photoId])
  @@schema("g_gallery")
}

model ActivityEvent {
  id        String       @id @default(cuid())
  galleryId String
  gallery   Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId   String?
  photo     Photo?       @relation(fields: [photoId], references: [id], onDelete: SetNull)
  viewerId  String?
  viewer    Viewer?      @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  type      ActivityType
  createdAt DateTime     @default(now())

  @@index([galleryId, createdAt(sort: Desc)])
  @@index([photoId, type, viewerId])
  @@schema("g_gallery")
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  @@schema("g_gallery")
}

/// Single-row table written by the 3×/day PostgREST keep-alive cron (docs/PLAN.md §9)
model Keepalive {
  id       Int      @id @default(1)
  pingedAt DateTime @default(now())
  @@schema("g_gallery")
}
