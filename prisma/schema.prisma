generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Shared Supabase project (the wedding site's booking/orders data lives in
  // `public`) — g-gallery gets its own schema so migrations, RLS, and the
  // Prisma client never touch anything outside it.
  schemas  = ["g_gallery"]
}

// ---------------------------------------------------------------------------
// better-auth core models (admin plugin fields included) — keep in sync with
// `npx @better-auth/cli generate` output when upgrading better-auth.
// ---------------------------------------------------------------------------

model User {
  id             String    @id
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  role           String?
  banned         Boolean?  @default(false)
  banReason      String?
  banExpires     DateTime?
  feedLastReadAt DateTime?
  /// Start of the last digest window actually emailed. Vercel documents cron
  /// delivery as best effort — a run can be delivered twice — and the digest is
  /// the one job where that would be visible to the recipient.
  digestSentFor  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  galleries         Gallery[]
  events            Event[]
  pushSubscriptions PushSubscription[]
  promoCards        PromoCard[]

  @@map("user")
  @@schema("g_gallery")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
  @@schema("g_gallery")
}

model Account {
  id                    String    @id
  // OIDC issuer of the identity, e.g. "https://accounts.google.com". Required
  // since better-auth 1.7 — accounts are keyed by (issuer, accountId), not by
  // providerId, so the same subject from two providers can't collide.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
  @@schema("g_gallery")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("g_gallery")
}

// ---------------------------------------------------------------------------
// Domain: galleries & photos
// ---------------------------------------------------------------------------

enum GalleryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("g_gallery")
}

enum PhotoStatus {
  PENDING // presigned URL issued, upload not confirmed
  CONFIRMED // ETag checked in — visible in the gallery
  FAILED

  @@schema("g_gallery")
}

/// Who put the file there (docs/GUEST-GALLERIES.md §3). Structural, not a view
/// filter: guest photos live in their own gallery, and this records attribution
/// inside it — plus it is what the per-gallery guest quota counts.
enum PhotoSource {
  OWNER
  GUEST

  @@schema("g_gallery")
}

enum StorageTier {
  STANDARD
  INFREQUENT_ACCESS

  @@schema("g_gallery")
}

/// Background "download all" ZIP build (docs/TODO.md §7) — NONE until the
/// first build kicks off; any photo add/delete after READY drops it back to
/// PENDING rather than serving a stale archive.
enum ZipStatus {
  NONE
  PENDING
  BUILDING
  READY
  FAILED

  @@schema("g_gallery")
}

/// The wedding page (docs/GUEST-GALLERIES.md §2): one unlisted address that
/// lists several separate galleries and grows over time. Deliberately NOT the
/// owner of access — each gallery keeps its own ShareLink, and `listedOnEvent`
/// only decides whether a card for it shows up here.
model Event {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  eventDate   DateTime?
  /// Free-text place shown under the title ("Statek Benice"); cosmetic.
  venue       String?
  /// SHA-256 of the 128-bit event token — the only thing access resolves by.
  /// A *different secret* from any gallery's token, which is what keeps a
  /// forwarded gallery link from exposing the wedding page.
  tokenHash   String    @unique
  /// The same token, AES-256-GCM encrypted so the admin can show and copy the
  /// address at any time (src/lib/token-cipher.ts). Never resolves anything;
  /// null when TOKEN_ENCRYPTION_KEY is unset or the row predates it.
  tokenCipher String?
  /// Readable URL hint frozen at creation, never parsed for resolution.
  slug        String
  /// Set when the whole wedding is moved to trash from the admin UI
  trashedAt   DateTime?
  /// Deadline for permanent deletion (trashedAt + 30 days)
  purgeAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  galleries Gallery[]

  @@index([ownerId, trashedAt])
  @@schema("g_gallery")
}

model Gallery {
  id                String        @id @default(cuid())
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  eventDate         DateTime?
  status            GalleryStatus @default(DRAFT)
  /// The photo the couple's family sees first. Chosen in the admin, because
  /// "whatever was uploaded last" is the sparkler exit at ISO 12800 as often as
  /// it is the portrait. SetNull, never Cascade: deleting the chosen photo must
  /// leave the gallery alone and drop it back to the newest-first fallback,
  /// which is also why the dangling-id case cannot happen at all.
  coverPhotoId      String?
  coverPhoto        Photo?        @relation("GalleryCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  /// R2 key prefix: "galleries/<128-bit-random>" — unguessable, rotated on expiry
  storagePrefix     String        @unique
  publishedAt       DateTime?
  archivedAt        DateTime?
  /// Set when the gallery is moved to trash from the admin UI; null means it is live
  trashedAt         DateTime?
  /// Deadline for permanent deletion (trashedAt + 30 days) — the purge cron deletes past this
  purgeAt           DateTime?
  /// Throttle for instant owner push notifications (≥30 min between pushes)
  lastInstantPushAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// docs/TODO.md §7 — pre-built "download all" archive, built in the background
  /// on Cloudflare's free tier (R2 multipart + Queues), never on Vercel.
  zipStatus        ZipStatus @default(NONE)
  /// R2 object key once READY — a direct link, no Worker involved at download time
  zipObjectKey     String?
  zipSizeBytes     Int?
  zipBuiltAt       DateTime?
  /// R2 multipart upload id while BUILDING — needed to list/finalize/abort it
  zipUploadId      String?
  /// Part count the finalize step waits for via R2 listParts — set at kickoff,
  /// since it's computed from the entry list, not discovered afterwards
  zipPartsExpected Int?

  /// Which wedding page lists this gallery, if any. Nullable by design:
  /// a standalone gallery with no wedding page around it stays legal.
  /// SetNull, never Cascade — deleting the wedding page must not delete the
  /// photographer's galleries.
  eventId       String?
  event         Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Slug identifying this gallery *within* its wedding page
  /// (`/s/{token}/{slug}/{eventKey}`), frozen when the gallery is attached.
  /// Unique per wedding, not globally.
  eventKey      String?
  /// Order of the cards on the wedding page.
  position      Int        @default(0)
  /// Whether a card for this gallery is shown to whoever holds the event link.
  /// Independent of whether the gallery's own share link works — the two
  /// switches are the whole access model (docs/GUEST-GALLERIES.md §3).
  listedOnEvent Boolean    @default(true)
  /// Which ShareLink the card points at. A gallery may have several (one with
  /// a password, one without), so the page is told rather than guessing.
  eventLinkId   String?
  eventLink     ShareLink? @relation("EventCardLink", fields: [eventLinkId], references: [id], onDelete: SetNull)

  photos         Photo[]         @relation("GalleryPhotos")
  shareLinks     ShareLink[]     @relation("GalleryShareLinks")
  viewers        Viewer[]
  sessions       ViewSession[]
  activityEvents ActivityEvent[]
  promos         GalleryPromo[]

  @@unique([eventId, eventKey])
  @@index([ownerId, status])
  @@index([eventId, position])
  @@index([zipStatus])
  @@schema("g_gallery")
}

model Photo {
  id                 String      @id @default(cuid())
  galleryId          String
  gallery            Gallery     @relation("GalleryPhotos", fields: [galleryId], references: [id], onDelete: Cascade)
  /// Full R2 object key ("<storagePrefix>/<random-uuid>.jpg")
  objectKey          String      @unique
  /// Original filename, used for ZIP entries and downloads
  fileName           String
  mimeType           String      @default("image/jpeg")
  sizeBytes          Int?
  /// CRC32 (hex) computed in the browser at upload — feeds the streaming ZIP writer
  crc32              String?
  etag               String?
  width              Int?
  height             Int?
  /// Average colour as "#rrggbb", computed in the browser at upload. Fills the
  /// tile before any bytes arrive; 7 bytes per photo rather than the ~400 a
  /// base64 blur placeholder would add to every page render.
  placeholder        String?
  status             PhotoStatus @default(PENDING)
  storageTier        StorageTier @default(STANDARD)
  /// A 512 px WebP the uploading browser produced, stored beside the original
  /// (docs/GUEST-GALLERIES.md §9). Null whenever the device could not make one
  /// — the grid then falls back to a Cloudflare transformation, exactly as
  /// before this existed. Derived from `objectKey`, never client-supplied.
  thumbObjectKey     String?
  /// OWNER unless a guest uploaded it through a share link with allowUpload.
  source             PhotoSource @default(OWNER)
  /// Which viewer added it, for attribution and for the per-guest quota.
  /// SetNull, never Cascade: the 13-month viewer cleanup (docs/PLAN.md §8)
  /// must forget who uploaded a photo without deleting the photo itself.
  uploadedByViewerId String?
  uploadedBy         Viewer?     @relation("GuestUploads", fields: [uploadedByViewerId], references: [id], onDelete: SetNull)
  /// When the shot was taken: EXIF DateTimeOriginal read in the browser at
  /// upload, falling back to the file's mtime, then to confirm time. Drives
  /// the gallery timeline (oldest first — the day as it happened). Null only
  /// while a row is still PENDING; confirm always sets it.
  takenAt            DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  favorites       Favorite[]
  reactions       Reaction[]
  printSelections PrintSelection[]
  activityEvents  ActivityEvent[]
  /// Galleries using this photo as their cover — at most one in practice.
  coverOf         Gallery[]        @relation("GalleryCover")

  @@index([galleryId, status])
  /// Timeline ordering for the guest gallery and the ZIP entry order.
  @@index([galleryId, status, takenAt])
  /// Drives the per-gallery guest quota count and the admin's "from guests" view.
  @@index([galleryId, source])
  @@index([uploadedByViewerId])
  @@schema("g_gallery")
}

model ShareLink {
  id                   String    @id @default(cuid())
  galleryId            String
  gallery              Gallery   @relation("GalleryShareLinks", fields: [galleryId], references: [id], onDelete: Cascade)
  /// SHA-256 of the 128-bit share token — the only thing access resolves by
  tokenHash            String    @unique
  /// The same token, AES-256-GCM encrypted for display in the admin
  /// (src/lib/token-cipher.ts). Never resolves anything; null when
  /// TOKEN_ENCRYPTION_KEY is unset or the row predates it, which just means
  /// the link can no longer be shown.
  tokenCipher          String?
  label                String?
  /// scrypt hash "salt:key"; null = no password
  passwordHash         String?
  expiresAt            DateTime?
  revokedAt            DateTime?
  allowDownload        Boolean   @default(true)
  allowReactions       Boolean   @default(true)
  /// Guests may mark photos for print with a quantity (1-99). Same risk profile
  /// as allowReactions — a per-viewer mark, not a write of new content — so it
  /// defaults on rather than off like allowUpload.
  allowPrintSelection  Boolean   @default(true)
  /// Guests holding this link may add photos to the gallery
  /// (docs/GUEST-GALLERIES.md §6). Off by default: every link that existed
  /// before this column was read-only, and silently widening one would be the
  /// worst possible default for a feature that opens an anonymous write path.
  allowUpload          Boolean   @default(false)
  /// Consecutive wrong-password unlock attempts; resets to 0 on success (anti-brute-force)
  failedUnlockAttempts Int       @default(0)
  /// Set once failedUnlockAttempts hits the threshold; unlock is refused (no scrypt call) until this passes
  unlockLockedUntil    DateTime?
  /// Readable URL hint frozen at creation from title+eventDate (docs/TODO.md §6) —
  /// cosmetic only, never resolves anything; tokenHash is still the sole authority.
  /// Null on links created before this existed — `/g/{token}` alone still works.
  slug                 String?
  createdAt            DateTime  @default(now())

  viewers      Viewer[]
  /// Galleries whose wedding-page card points at this link.
  eventCardFor Gallery[] @relation("EventCardLink")

  @@index([galleryId])
  @@schema("g_gallery")
}

// ---------------------------------------------------------------------------
// Promo cards — the photographer's own credit tile inside the grid
// ---------------------------------------------------------------------------

/// How a promo tile is painted. Three fixed looks rather than a colour picker:
/// the tile sits between the photographer's own photos, and the one thing it
/// must never do is clash with them.
enum PromoTheme {
  /// Brand ink on a warm near-white — reads as a caption card, not an ad.
  LIGHT
  /// Warm near-white on brand ink — the strongest of the three.
  DARK
  /// White on brand terracotta.
  BRAND

  @@schema("g_gallery")
}

/// Reusable "who photographed this" card the owner writes once and places into
/// any gallery's grid (see `GalleryPromo` for the placement). Content lives
/// here so fixing a typo or a moved URL fixes every gallery at once, rather
/// than needing every delivered gallery re-edited.
///
/// Deliberately text-only: the tile shares a row with actual photographs, and
/// a second image competing with them is exactly what makes a gallery look
/// like a website with ads in it.
model PromoCard {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Admin-only name, never shown to a viewer — how the owner tells two cards
  /// apart in the picker ("Web 2026", "Instagram").
  name      String
  /// Small line above the headline ("Fotografie"), optional.
  eyebrow   String?
  headline  String
  body      String?
  /// Call-to-action label; falls back to the bare host name of `ctaUrl`.
  ctaLabel  String?
  /// Absolute http(s) URL. Validated on write — it is rendered as a link into
  /// pages held by people who are not the owner.
  ctaUrl    String
  theme     PromoTheme @default(LIGHT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  placements GalleryPromo[]

  @@index([ownerId])
  @@schema("g_gallery")
}

/// One card placed in one gallery. Separate from `PromoCard` because the slot
/// is a property of the gallery, not of the card: the same "about me" card sits
/// 5th in a 60-photo gallery and 5th in an 800-photo one, but either could be
/// moved without touching the other.
model GalleryPromo {
  id          String    @id @default(cuid())
  galleryId   String
  gallery     Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  promoCardId String
  promoCard   PromoCard @relation(fields: [promoCardId], references: [id], onDelete: Cascade)
  /// 1-based position in the grid: `slot = 5` makes the card the 5th tile, so
  /// what used to be the 5th photo becomes the 6th. Clamped to the end of the
  /// stream when the gallery holds fewer photos than that (see
  /// `src/lib/promo-card.ts`). 1-based on purpose — it is a position a person
  /// types into the admin, and a 0-based one there is a bug generator.
  slot        Int       @default(5)
  /// Off keeps the placement (and its slot) while taking the tile out of the
  /// grid — the same switch shape as `Gallery.listedOnEvent`.
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// One placement per card per gallery. Placing the same card twice is always
  /// a mistake; two *different* cards in one gallery stays legal.
  @@unique([galleryId, promoCardId])
  @@index([galleryId, enabled])
  @@index([promoCardId])
  @@schema("g_gallery")
}

// ---------------------------------------------------------------------------
// Activity & notifications (see docs/PLAN.md §8)
// GDPR: no IPs stored; viewer identity is a first-party anonKey; everything
// cascades away with the gallery; anonKey lifetime ≤ 13 months (cleanup job).
// ---------------------------------------------------------------------------

enum ActivityType {
  GALLERY_VIEW
  PHOTO_VIEW
  REACTION
  FAVORITE
  DOWNLOAD
  PRINT_SELECT
  VISITOR_IDENTIFIED

  @@schema("g_gallery")
}

model Viewer {
  id          String     @id @default(cuid())
  galleryId   String
  gallery     Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  shareLinkId String?
  shareLink   ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  /// First-party localStorage UUID (crypto.randomUUID()) — the only viewer identifier
  anonKey     String
  /// Voluntarily entered via the "Kdo se dívá?" prompt — the Google Photos "join" moment
  displayName String?
  optedOut    Boolean    @default(false)
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  sessions        ViewSession[]
  favorites       Favorite[]
  reactions       Reaction[]
  printSelections PrintSelection[]
  activityEvents  ActivityEvent[]
  uploads         Photo[]          @relation("GuestUploads")

  @@unique([galleryId, anonKey])
  @@schema("g_gallery")
}

model ViewSession {
  id             String   @id @default(cuid())
  viewerId       String
  viewer         Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  galleryId      String
  gallery        Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([galleryId, startedAt])
  @@schema("g_gallery")
}

model Favorite {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([photoId, viewerId])
  @@schema("g_gallery")
}

model PrintSelection {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  /// 1-99; the row is deleted once this would drop to 0 (mirrors Favorite toggle-off)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([photoId, viewerId])
  @@index([photoId])
  @@schema("g_gallery")
}

/// Fixed set — an open emoji field would be a free-text channel from anonymous
/// viewers into the owner's admin, and every value is a UI variant to design.
enum ReactionKind {
  LOVE
  WOW
  LAUGH
  SAD
  CLAP

  @@schema("g_gallery")
}

model Reaction {
  id        String       @id @default(cuid())
  photoId   String
  photo     Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    Viewer       @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  /// One reaction per viewer per photo: picking another kind replaces it,
  /// which keeps the per-photo tally a count of people, not of clicks.
  @@unique([photoId, viewerId])
  @@index([photoId])
  @@schema("g_gallery")
}

model ActivityEvent {
  id        String       @id @default(cuid())
  galleryId String
  gallery   Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photoId   String?
  photo     Photo?       @relation(fields: [photoId], references: [id], onDelete: SetNull)
  viewerId  String?
  viewer    Viewer?      @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  type      ActivityType
  createdAt DateTime     @default(now())

  @@index([galleryId, createdAt(sort: Desc)])
  @@index([photoId, type, viewerId])
  @@schema("g_gallery")
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())

  @@schema("g_gallery")
}

/// Single-row table written by the 3×/day PostgREST keep-alive cron (docs/PLAN.md §9)
model Keepalive {
  id       Int      @id @default(1)
  pingedAt DateTime @default(now())

  @@schema("g_gallery")
}
