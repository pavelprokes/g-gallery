{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 */8 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/reconcile?sweep=1",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 6 1 * *"
    }
  ]
}
