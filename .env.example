# Production / Supabase configuration. For local development against the
# Docker stack use .env.docker.example instead (see docs/DEVELOPMENT.md).

# --- Database (Supabase) ---------------------------------------------------
# Runtime: Supavisor TRANSACTION pooler (:6543) — keep ?pgbouncer=true
DATABASE_URL="postgres://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations/CLI: Supavisor SESSION pooler (:5432) — IPv4, works from CI
DIRECT_URL="postgres://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres"
# PostgREST keep-alive (cron) — service role key, server-only
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Realtime socket in the browser (Phase 3) — anon/publishable key, safe to expose
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Auth (better-auth) ----------------------------------------------------
BETTER_AUTH_SECRET="" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated emails that get the admin role on first sign-in
ADMIN_EMAILS="prokespavel09@gmail.com"

# --- Cloudflare R2 (jurisdiction=eu — note the .eu. endpoint) --------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="g-gallery"
R2_ENDPOINT="https://<account-id>.eu.r2.cloudflarestorage.com"
# R2 only accepts "auto" (the local MinIO stand-in needs a real region name).
S3_REGION="auto"

# --- Image delivery --------------------------------------------------------
# Transform backend for the custom next/image loader: cloudflare | imgproxy | none
NEXT_PUBLIC_IMAGE_TRANSFORM="cloudflare"
# Zone-hosted R2 custom domain; the loader builds {BASE}/cdn-cgi/image/... URLs.
# Unset = local passthrough.
NEXT_PUBLIC_PHOTOS_BASE_URL="https://photos.svatebni-fotograf-cechy.cz"

# --- Cron ------------------------------------------------------------------
CRON_SECRET="" # openssl rand -base64 32

# --- Notifications ---------------------------------------------------------
# Web Push (npx web-push generate-vapid-keys). Unset = push silently disabled,
# the daily digest still goes out.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:prokespavel09@gmail.com"
# Mail (docs/SETUP.md §8): RESEND_API_KEY wins if set, otherwise SMTP_URL,
# else sending is skipped with a warning rather than failing the cron.
# Production uses AWS SES over SMTP (shared verified domain with
# svatebni-fotograf-cechy-2.0) — leave RESEND_API_KEY unset in Vercel so it
# falls through to SMTP_URL. Percent-encode special characters in the SES
# SMTP password (e.g. '+' -> '%2B') since it sits inside a URL.
SMTP_URL="smtps://<smtp-user>:<url-encoded-smtp-pass>@email-smtp.<region>.amazonaws.com:465"
RESEND_API_KEY=""
MAIL_FROM="g-gallery <pavel@svatebni-fotograf-cechy.cz>"

# --- ZIP download (Cloudflare Worker, docs/SETUP.md §11) --------------------
# Unset = the download buttons return 503 rather than doing nothing silently.
ZIP_WORKER_URL="https://zip.svatebni-fotograf-cechy.cz"
# Must match the worker secret of the same name (wrangler secret put).
ZIP_SIGNING_SECRET=""
